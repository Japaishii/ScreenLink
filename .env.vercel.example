# Vercel > Project > Settings > Environment Variables
# Crie um banco libSQL/Turso e copie a URL e o token.
TURSO_DATABASE_URL=libsql://seu-banco.sua-organizacao.turso.io
TURSO_AUTH_TOKEN=seu-token-do-banco
# Opcional: origem exata, sem barra final. Omita em Preview.
# APP_ORIGIN=https://seu-projeto.vercel.app
# TURN externo, recomendado para testar entre redes diferentes.
# Separe URLs alternativas por vírgula. Prefira também turns: em 443.
TURN_URL=turn:seu-provedor:3478?transport=udp,turn:seu-provedor:3478?transport=tcp
TURN_USERNAME=usuario-fornecido-pelo-provedor
TURN_PASSWORD=senha-fornecida-pelo-provedor
# Alternativa para Coturn próprio, em vez de usuário/senha fixos:
# TURN_SECRET=segredo-compartilhado-com-seu-coturn
