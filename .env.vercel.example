# Vercel > Project > Settings > Environment Variables
# Crie um banco libSQL/Turso e copie a URL e o token.
TURSO_DATABASE_URL=libsql://seu-banco.sua-organizacao.turso.io
TURSO_AUTH_TOKEN=seu-token-do-banco
# Opcional: origem exata, sem barra final. Omita em Preview.
# APP_ORIGIN=https://seu-projeto.vercel.app
# TURN externo, recomendado para testar entre redes diferentes.
# Separe URLs alternativas por vírgula. Prefira também turns: em 443.
TURN_URL=turn:seu-provedor:3478?transport=udp,turn:seu-provedor:3478?transport=tcp
TURN_USERNAME=usuario-fornecido-pelo-provedor
TURN_PASSWORD=senha-fornecida-pelo-provedor
# Alternativa para Coturn próprio, em vez de usuário/senha fixos:
# TURN_SECRET=segredo-compartilhado-com-seu-coturn
# ID público da aplicação Discord para preencher o convite na sidebar.
# NEXT_PUBLIC_DISCORD_CLIENT_ID=123456789012345678

# Login social. Configure somente os provedores que deseja habilitar.
# Callback: https://seu-dominio/api/oauth/PROVEDOR/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# Opcional, domínio estável exato da autenticação. Veja docs/AUTH.md.
# AUTH_ORIGIN=https://seu-dominio

# Informações públicas dos documentos. Ausentes: campos sinalizados na minuta.
# NEXT_PUBLIC_LEGAL_OPERATOR=
# NEXT_PUBLIC_LEGAL_DOCUMENT=
# NEXT_PUBLIC_PRIVACY_EMAIL=

# Opcional: link público para o ZIP do desktop Windows x64
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=
